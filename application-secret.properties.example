# Copy this file to application-secret.properties and fill in your real credentials.
# Note: application-secret.properties is in .gitignore, so your real keys will NEVER be pushed to GitHub!

aws.access-key-id=YOUR_AWS_ACCESS_KEY_ID_HERE
aws.secret-access-key=YOUR_AWS_SECRET_ACCESS_KEY_HERE
aws.region=ap-south-1
s3.bucket.name=YOUR_S3_BUCKET_NAME_HERE
redis.url=redis://localhost:6379
